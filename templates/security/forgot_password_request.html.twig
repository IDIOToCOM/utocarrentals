{% extends 'base.html.twig' %}
{% import 'customer/_uto_form_field.html.twig' as uto %}

{% block title %}Forgot password — Uto{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/login.css') }}?v=1.7">
  <link rel="stylesheet" href="{{ asset('styles/uto-form-fields.css') }}?v=1.0">
{% endblock %}

{% block body %}
  <div class="bg-shape-1"></div>
  <div class="bg-shape-2"></div>

  <div class="login-container login-container--wide">
    <div class="login-header">
      <div class="logo logo--brand-img">
        <a href="{{ path('app_home') }}">
          <img class="auth-logo-img" src="{{ asset('images/uto-car-rentals-logo.png') }}?v=6" alt="UTO Car Rentals" width="220" height="72" decoding="async">
        </a>
      </div>
      <p class="login-subtitle">Enter your account email and we will send a reset link.</p>
    </div>

    {{ form_start(requestForm, { attr: { class: 'register-form register-form--stacked' } }) }}
      {{ uto.render(requestForm.email, { icon: 'fa-envelope', placeholder: 'you@example.com' }) }}
      <button type="submit" class="login-button">Send reset link</button>
    {{ form_end(requestForm) }}

    <div class="auth-switch">
      <a href="{{ path('app_login') }}">Back to sign in</a>
    </div>
  </div>
{% endblock %}
