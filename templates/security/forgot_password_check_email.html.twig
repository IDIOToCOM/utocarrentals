{% extends 'base.html.twig' %}

{% block title %}Check your email — Uto{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/login.css') }}?v=1.6">
{% endblock %}

{% block body %}
  <div class="bg-shape-1"></div>
  <div class="bg-shape-2"></div>

  <div class="login-container">
    <div class="login-header">
      <div class="logo logo--brand-img">
        <a href="{{ path('app_home') }}">
          <img class="auth-logo-img" src="{{ asset('images/uto-car-rentals-logo.png') }}?v=6" alt="UTO Car Rentals" width="220" height="72" decoding="async">
        </a>
      </div>
      <p class="login-subtitle">If an account exists for that email, we sent a password reset link. It expires in one hour.</p>
    </div>

    <div class="auth-switch">
      <a href="{{ path('app_login') }}">Back to sign in</a>
    </div>
  </div>
{% endblock %}
