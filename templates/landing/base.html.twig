<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Uto — modern vehicle rentals. Book reliable cars with transparent pricing and flexible plans.">
  <title>{% block title %}Uto — Drive what matters{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="{{ asset('styles/landing.css') }}?v=3.5">
  {% if app.user %}
    <link rel="stylesheet" href="{{ asset('styles/notifications.css') }}?v=1.1">
    <link rel="stylesheet" href="{{ asset('styles/booking-confirm-modal.css') }}?v=1.0">
  {% endif %}
  {% block stylesheets %}{% endblock %}
</head>
<body class="landing-body">
  <div class="lp-bg-shape lp-bg-shape-1" aria-hidden="true"></div>
  <div class="lp-bg-shape lp-bg-shape-2" aria-hidden="true"></div>
  {% block body %}{% endblock %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  {% if app.user %}
    {% include 'notification/_scripts.html.twig' %}
    <script src="{{ asset('js/booking-confirm-modal.js') }}?v=1.0"></script>
  {% endif %}
  {% block javascripts %}{% endblock %}
</body>
</html>
