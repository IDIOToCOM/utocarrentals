{% extends 'base.html.twig' %}

{% block title %}Edit Booking{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/car_inventory.css') }}?v=3.0">
    <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.1">
    <link rel="stylesheet" href="{{ asset('vendor/flatpickr/flatpickr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/flatpickr/dark.css') }}">
    {% include 'booking/_flatpickr_range_legend_styles.html.twig' %}
    {% include 'booking/_flatpickr_booking_time_styles.html.twig' %}
    <style>
      .flatpickr-calendar.open { z-index: 3000 !important; }
      .flatpickr-calendar { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45); }
      .flatpickr-day.selected,
      .flatpickr-day.startRange,
      .flatpickr-day.endRange { background: #6366f1; border-color: #6366f1; color: #fff; }
      .flatpickr-day.inRange {
        background: rgba(99, 102, 241, 0.22);
        border-color: transparent;
        box-shadow: none;
      }
    </style>
{% endblock %}

{% block body %}
<!-- Top Bar -->
{% include 'admin/_topbar_minimal.html.twig' %}

<div class="container">
  <!-- Page Title -->
  <h1 class="page-title">Edit Booking</h1>

  {% if form is defined %}
    {{ form_errors(form) }}
  {% endif %}

  <!-- Flash Messages -->
  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <!-- Form Card -->
  <div class="uto-card">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

      {% include 'booking/_booking_form_fields.html.twig' %}

      <div class="d-flex justify-content-between mt-4">
        <a href="{{ path('app_booking_index') }}" class="btn btn-outline-secondary">← Back to List</a>
        <button type="submit" class="btn btn-success" id="submit-booking-btn">✔ Update</button>
      </div>
    {{ form_end(form) }}

    <!-- Delete button -->
    <div class="mt-3 text-end">
      {{ include('booking/_delete_form.html.twig') }}
    </div>
  </div>
</div>

{% include 'booking/_rental_flatpickr.html.twig' %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  let isSubmitting = false;
  
  if (!form) {
    console.error('Form not found!');
    return;
  }

  function parseTimeToMinutes(s) {
    s = (s || '').trim();
    var m12 = s.match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*(AM|PM|am|pm)/i);
    if (m12) {
      var h = parseInt(m12[1], 10);
      var mi = parseInt(m12[2], 10);
      var ap = m12[3].toUpperCase();
      if (ap === 'PM' && h < 12) h += 12;
      if (ap === 'AM' && h === 12) h = 0;
      return h * 60 + mi;
    }
    var parts = s.split(':');
    if (parts.length < 2) return NaN;
    return parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
  }

  function to24HourString(s) {
    var mins = parseTimeToMinutes(s);
    if (isNaN(mins)) return s;
    var h = Math.floor(mins / 60);
    var m = mins % 60;
    return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
  }

  function combineDateTimeFromParts(ymd, timeStr) {
    if (!ymd || !timeStr) return null;
    var dp = ymd.split('-').map(Number);
    if (dp.length !== 3 || dp.some(isNaN)) return null;
    var mins = parseTimeToMinutes(to24HourString(timeStr));
    if (isNaN(mins)) return null;
    return new Date(dp[0], dp[1] - 1, dp[2], Math.floor(mins / 60), mins % 60, 0, 0);
  }
  
  const submitHandler = function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    console.log('Form submit event triggered');
    
    if (isSubmitting) {
      console.log('Already submitting, ignoring');
      return false;
    }
    
    // Validate all required fields first
    const nameInput = document.querySelector('[name*="[name]"]');
    const phoneInput = document.querySelector('[name*="[phone]"]');
    const carInput = document.querySelector('[name*="[car]"]');
    const pickupLocationInput = document.querySelector('[name*="[pickupLocation]"]');
    const dropoffLocationInput = document.querySelector('[name*="[dropoffLocation]"]');
    const pickupDateInput = document.querySelector('[name*="[pickupDate]"]');
    const returnDateInput = document.querySelector('[name*="[returnDate]"]');
    const pickupTimeInput = document.querySelector('[name*="[pickupTime]"]');
    const returnTimeInput = document.querySelector('[name*="[returnTime]"]');
    
    const missingFields = [];
    
    if (!nameInput || !nameInput.value.trim()) {
      missingFields.push('Name');
    }
    if (!phoneInput || !phoneInput.value.trim()) {
      missingFields.push('Phone number');
    } else {
      const phoneDigits = phoneInput.value.replace(/\D/g, '');
      if (phoneDigits.length < 10) {
        missingFields.push('Phone number (at least 10 digits)');
      }
    }
    if (!carInput || !carInput.value || carInput.value === '') {
      missingFields.push('Car');
    }
    if (!pickupLocationInput || !pickupLocationInput.value.trim()) {
      missingFields.push('Pickup Location');
    }
    if (!dropoffLocationInput || !dropoffLocationInput.value.trim()) {
      missingFields.push('Dropoff Location');
    }
    if (!pickupDateInput || !pickupDateInput.value) {
      missingFields.push('Pickup Date');
    }
    if (!returnDateInput || !returnDateInput.value) {
      missingFields.push('Return Date');
    }
    if (!pickupTimeInput || !pickupTimeInput.value) {
      missingFields.push('Pickup Time');
    }
    if (!returnTimeInput || !returnTimeInput.value) {
      missingFields.push('Return Time');
    }
    
    if (missingFields.length > 0) {
      const fieldList = missingFields.join(', ');
      showWarningModal('Please fill in all required fields: ' + fieldList);
      isSubmitting = false;
      return false;
    }
    
    // Ensure all inputs exist before accessing their values
    if (!pickupDateInput || !returnDateInput || !pickupTimeInput || !returnTimeInput) {
      showWarningModal('Please fill in all required fields.');
      isSubmitting = false;
      return false;
    }
    
    const pickupDate = pickupDateInput.value;
    const returnDate = returnDateInput.value;
    let pickupTime = pickupTimeInput.value;
    let returnTime = returnTimeInput.value;
    
    // Double-check that values are not empty
    if (!pickupDate || !returnDate || !pickupTime || !returnTime) {
      showWarningModal('Please fill in all required fields.');
      isSubmitting = false;
      return false;
    }
    
    console.log('Form values:', { pickupDate, returnDate, pickupTime, returnTime });
    
    // Validation
    let errorMessage = '';
    
    // Get today's date (date only, no time)
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    if (pickupDate) {
      // Compare pickup date with today
      const pickupDateObj = new Date(pickupDate);
      pickupDateObj.setHours(0, 0, 0, 0);
      
      // Check if pickup date is in the past
      if (pickupDateObj < today) {
        errorMessage = 'Pickup date cannot be in the past.';
      }
    }
    
    if (returnDate) {
      // Compare return date with today
      const returnDateObj = new Date(returnDate);
      returnDateObj.setHours(0, 0, 0, 0);
      
      // Check if return date is in the past
      if (returnDateObj < today) {
        errorMessage = 'Return date cannot be in the past.';
      }
    }
    
    if (pickupDate && returnDate) {
      // Compare dates (date only, no time)
      const pickupDateObj = new Date(pickupDate);
      const returnDateObj = new Date(returnDate);
      
      // Reset time to compare dates only
      pickupDateObj.setHours(0, 0, 0, 0);
      returnDateObj.setHours(0, 0, 0, 0);
      
      // Check if pickup date is after return date
      if (pickupDateObj > returnDateObj) {
        errorMessage = 'Pickup date cannot be after return date.';
      }
      
      // If same day, check times (supports 12h AM/PM and 24h)
      if (pickupDate === returnDate && pickupTime && returnTime) {
        const puM = parseTimeToMinutes(pickupTime);
        const retM = parseTimeToMinutes(returnTime);
        if (!isNaN(puM) && !isNaN(retM) && puM >= retM) {
          errorMessage = 'Pickup time cannot be after or equal to return time on the same day.';
        }
      }
    }

    if (!errorMessage && pickupDate && returnDate && pickupTime && returnTime && window.UtoBookingTimeRules) {
      const puDt = combineDateTimeFromParts(pickupDate, pickupTime);
      const retDt = combineDateTimeFromParts(returnDate, returnTime);
      const scheduleErrs = window.UtoBookingTimeRules.scheduleErrors(puDt, retDt, new Date());
      if (scheduleErrs.length) {
        errorMessage = scheduleErrs[0];
      }
    }
    
    // If validation fails, show modal
    if (errorMessage) {
      showWarningModal(errorMessage);
      isSubmitting = false;
      return false;
    }
    
    // Check for car availability conflicts
    const carInput = document.querySelector('[name*="[car]"]');
    console.log('Car input:', carInput, 'Value:', carInput ? carInput.value : 'N/A');
    
    if (carInput && carInput.value) {
      // Get car ID from the select value
      const carId = carInput.value;
      const bookingId = {{ booking.id ?? 'null' }};
      
      console.log('Making conflict check request with:', {
        carId: carId,
        pickupDate: pickupDate,
        returnDate: returnDate,
        pickupTime: pickupTime,
        returnTime: returnTime,
        excludeBookingId: bookingId
      });
      
      // Make AJAX call to check for conflicts
      const conflictUrl = '{{ path('app_booking_check_conflict') }}';
      console.log('Conflict check URL:', conflictUrl);
      
      fetch(conflictUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          carId: carId,
          pickupDate: pickupDate,
          returnDate: returnDate,
          pickupTime: to24HourString(pickupTimeInput.value),
          returnTime: to24HourString(returnTimeInput.value),
          excludeBookingId: bookingId
        })
      })
      .then(response => {
        console.log('Response received, status:', response.status, 'statusText:', response.statusText);
        console.log('Response headers:', response.headers);
        
        if (!response.ok) {
          throw new Error('conflict_check_failed');
        }
        
        const contentType = response.headers.get('content-type');
        console.log('Response content-type:', contentType);
        
        if (contentType && contentType.includes('application/json')) {
          return response.json();
        } else {
          return response.text().then(text => {
            console.error('Unexpected response format:', text);
            throw new Error('Expected JSON but got: ' + contentType);
          });
        }
      })
      .then(data => {
        console.log('Conflict check response data:', data);
        console.log('hasConflict:', data.hasConflict, 'message:', data.message);
        
        if (data.hasConflict) {
          console.log('Conflict detected, showing modal');
          showWarningModal(data.message);
          isSubmitting = false;
          return false; // Prevent form submission
        } else {
          console.log('No conflict, submitting form');
          // If no conflict, submit the form normally
          isSubmitting = true;
          pickupTimeInput.value = to24HourString(pickupTimeInput.value);
          returnTimeInput.value = to24HourString(returnTimeInput.value);
          // Remove the event listener to allow natural form submission
          form.removeEventListener('submit', submitHandler);
          // Create and click a temporary submit button to ensure proper form submission
          const submitBtn = document.createElement('button');
          submitBtn.type = 'submit';
          submitBtn.style.display = 'none';
          form.appendChild(submitBtn);
          submitBtn.click();
        }
      })
      .catch(function () {
        showWarningModal('This car is not available for the selected dates and times. Choose different dates or another vehicle.');
        isSubmitting = false;
      });
      
      return false; // Prevent form submission until AJAX completes
    } else {
      // Car is required, so this should have been caught in the missing fields check
      // But just in case, show warning
      showWarningModal('Please select a car.');
      isSubmitting = false;
      return false;
    }
  };
  
  form.addEventListener('submit', submitHandler);
  
  function showWarningModal(message) {
    // Remove any existing modals first
    const existingModal = document.querySelector('.warning-overlay');
    if (existingModal) {
      existingModal.remove();
    }
    
    // Create modal overlay
    const overlay = document.createElement('div');
    overlay.className = 'warning-overlay';
    
    // Create modal dialog
    const modal = document.createElement('div');
    modal.className = 'warning-modal';
    
    modal.innerHTML = `
      <h3>⚠️ Validation Warning</h3>
      <p id="warning-message"></p>
      <div class="warning-buttons">
        <button type="button" id="warning-ok">OK</button>
      </div>
    `;

    var msgEl = modal.querySelector('#warning-message');
    if (msgEl) {
      msgEl.textContent = message;
    }
    
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    
    // Handle OK button
    document.getElementById('warning-ok').addEventListener('click', function() {
      overlay.classList.add('fade-out');
      modal.classList.add('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        document.getElementById('warning-ok').click();
      }
    });
  }
  
  // Delete confirmation handler
  $('.delete-btn').on('click', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'car' ? 'car' : 'user';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });
  
  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'car' ? 'car' : 'user';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
      }
    });
  }
});
</script>
{% endblock %}