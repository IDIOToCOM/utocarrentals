{% extends 'base.html.twig' %}

{% block title %}Booking Index{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/car_inventory.css') }}?v=3.3">
  <link rel="stylesheet" href="{{ asset('styles/admin_sidebar.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.0">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block body %}
<div class="admin-layout">
  
  {% include 'booking/_sidebar.html.twig' %}

  <!-- ✅ Main Content -->
  <main class="admin-content">
    {% include 'admin/_topbar.html.twig' %}

    <div class="container">
      <h1 class="page-title">Booking Index</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="table-container">
        <table class="table" id="bookingsTable"
               data-poll-url="{{ path('app_booking_poll') }}"
               data-initial-total="{{ bookings|length }}"
               data-initial-fingerprint="{% for booking in bookings %}{{ booking.id }}{% if not loop.last %},{% endif %}{% endfor %}">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Status</th>
              <th>Car</th>
              <th>Pickup Location</th>
              <th>Drop-off Location</th>
              <th>Pickup Date & Time</th>
              <th>Return Date & Time</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="bookingsTableBody">{% include 'booking/_rows.html.twig' with { bookings: bookings, paymentsByBooking: paymentsByBooking } %}</tbody>
        </table>
      </div>

      <div class="text-center mt-3">
        <a href="{{ path('app_booking_new') }}" class="btn btn-create"><i class="fas fa-plus"></i> Create New Booking</a>
      </div>

    </div>
  </main>
</div>

<!-- ✅ Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
$(document).ready(function() {
  // Sidebar toggle for mobile
  $('#sidebarToggle').on('click', function() {
    $('.admin-sidebar').toggleClass('collapsed');
    $('.admin-content').toggleClass('expanded');
  });

  // DataTable custom filtering
  $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
    const search = $('.dataTables_filter input').val().trim().toLowerCase();
    if (!search) return true;
    return data.join(' ').toLowerCase().includes(search);
  });

  const tableElement = $('#bookingsTable');
  let table = tableElement.DataTable({
    ordering: false,
    paging: true,
    searching: true
  });

  $('.dataTables_filter input').on('keyup', function() {
    table.draw();
});

  let lastSnapshot = String(tableElement.data('initial-total') || 0) + '|' + String(tableElement.data('initial-fingerprint') || '');
  let pollInFlight = false;

  function bookingSnapshot(payload) {
    return String(payload.total || 0) + '|' + String(payload.fingerprint || '');
  }

  function refreshBookingRows(rowsHtml) {
    const currentPage = table.page();
    const currentSearch = table.search();
    table.destroy();
    $('#bookingsTableBody').html(rowsHtml);
    if (window.BookingConfirmModal && typeof window.BookingConfirmModal.init === 'function') {
      window.BookingConfirmModal.init();
    }
    table = tableElement.DataTable({
      ordering: false,
      paging: true,
      searching: true
    });
    table.search(currentSearch).draw(false);
    table.page(currentPage).draw(false);
  }

  function pollBookings() {
    if (pollInFlight || document.hidden) {
      return;
    }
    const pollUrl = tableElement.data('poll-url');
    if (!pollUrl) {
      return;
    }

    pollInFlight = true;
    fetch(pollUrl, {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      credentials: 'same-origin',
      cache: 'no-store'
    })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('Failed to poll bookings');
        }
        return response.json();
      })
      .then(function(payload) {
        if (!payload || typeof payload.rowsHtml !== 'string') {
          return;
        }
        const snapshot = bookingSnapshot(payload);
        if (snapshot !== lastSnapshot) {
          refreshBookingRows(payload.rowsHtml);
          lastSnapshot = snapshot;
        }
      })
      .catch(function() {
        // Ignore transient errors and retry next cycle.
      })
      .finally(function() {
        pollInFlight = false;
      });
  }

  pollBookings();
  setInterval(pollBookings, 5000);

// Logout confirmation dialog
  $('#logout-btn').on('click', function(e) {
    e.preventDefault();
    
    // Remove any existing modals first
    $('.logout-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('logout-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('logout-modal').html(`
      <h3>Logout Confirmation</h3>
      <p>Are you sure you want to logout?</p>
      <div class="logout-buttons">
        <button id="confirm-yes">Yes</button>
        <button id="confirm-no">No</button>
        </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
        window.location.href = '{{ path('app_logout') }}';
    });
    
    // Handle No button - remove modal
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
    });
  });
  
  // Delete confirmation handler
  $(document).on('click', '.delete-btn', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'car' ? 'car' : 'user';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });
  
  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'car' ? 'car' : 'user';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
  });
  }
});
</script>
{% endblock %}
