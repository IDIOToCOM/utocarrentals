{% extends 'base.html.twig' %}

{% block title %}Booking Index{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/car_inventory.css') }}?v=3.3">
  <link rel="stylesheet" href="{{ asset('styles/admin_sidebar.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.0">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block body %}
<div class="admin-layout">
  
  {% include 'booking/_sidebar.html.twig' %}

  <!-- ✅ Main Content -->
  <main class="admin-content">
    {% include 'admin/_topbar.html.twig' %}

    <div class="container">
      <h1 class="page-title">Booking Index</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Status</th>
              <th>Car</th>
              <th>Pickup Location</th>
              <th>Drop-off Location</th>
              <th>Pickup Date & Time</th>
              <th>Return Date & Time</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for booking in bookings %}
            <tr>
              <td data-label="ID">{{ booking.id }}</td>
              <td data-label="Name">{{ booking.name }}</td>
              <td data-label="Phone">{{ booking.phone|default('—') }}</td>
              <td data-label="Status">{{ booking.status }}</td>
              <td data-label="Car">
                {% if booking.car %}
                  {{ booking.car.Brand }} {{ booking.car.Model }} (ID: {{ booking.car.id }})
                {% else %}
                  <span style="color: #6b7280;">Not assigned</span>
                {% endif %}
              </td>
              <td data-label="Pickup Location">{{ booking.pickupLocation }}</td>
              <td data-label="Drop-off Location">{{ booking.dropoffLocation }}</td>
              <td data-label="Pickup Date & Time">
                {% if booking.pickupDate %}
                  {{ booking.pickupDate|date('Y-m-d') }}
                  {% if booking.pickupTime %}
                    <br><small style="color: #6b7280;">{{ booking.pickupTime|date('g:i A') }}</small>
                  {% endif %}
                {% else %}
                  -
                {% endif %}
              </td>
              <td data-label="Return Date & Time">
                {% if booking.returnDate %}
                  {{ booking.returnDate|date('Y-m-d') }}
                  {% if booking.returnTime %}
                    <br><small style="color: #6b7280;">{{ booking.returnTime|date('g:i A') }}</small>
                  {% endif %}
                {% else %}
                  -
                {% endif %}
              </td>
              <td data-label="Actions" class="booking-actions-cell">
                <div class="actions-container booking-actions">
                  {% include 'booking/_status_actions.html.twig' %}
                  <div class="booking-actions-row booking-actions-row--main">
                    <a href="{{ path('app_booking_show', {'id': booking.id}) }}" class="btn btn-show"><i class="fas fa-eye"></i> Show</a>
                    <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
                    {% set isOwner = false %}
                    {% if booking.createdBy is not null and app.user is not null %}
                      {% set createdById = booking.createdBy.id %}
                      {% set currentUserId = app.user.id %}
                      {% if createdById == currentUserId %}
                        {% set isOwner = true %}
                      {% endif %}
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') or isOwner %}
                      <form method="post" action="{{ path('app_booking_delete', {'id': booking.id}) }}" class="delete-form" data-entity-name="booking">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
                        <button type="button" class="btn btn-danger delete-btn"><i class="fas fa-trash"></i> Delete</button>
                      </form>
                    {% endif %}
                  </div>
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="10" class="empty-state">No bookings found</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="text-center mt-3">
        <a href="{{ path('app_booking_new') }}" class="btn btn-create"><i class="fas fa-plus"></i> Create New Booking</a>
      </div>

    </div>
  </main>
</div>

<!-- ✅ Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
$(document).ready(function() {
  // Sidebar toggle for mobile
  $('#sidebarToggle').on('click', function() {
    $('.admin-sidebar').toggleClass('collapsed');
    $('.admin-content').toggleClass('expanded');
  });

  // DataTable custom filtering
  $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
    const search = $('.dataTables_filter input').val().trim().toLowerCase();
    if (!search) return true;
    return data.join(' ').toLowerCase().includes(search);
  });

  const table = $('.table').DataTable({
    ordering: false,
    paging: true,
    searching: true
  });

  $('.dataTables_filter input').on('keyup', function() {
    table.draw();
});

// Logout confirmation dialog
  $('#logout-btn').on('click', function(e) {
    e.preventDefault();
    
    // Remove any existing modals first
    $('.logout-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('logout-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('logout-modal').html(`
      <h3>Logout Confirmation</h3>
      <p>Are you sure you want to logout?</p>
      <div class="logout-buttons">
        <button id="confirm-yes">Yes</button>
        <button id="confirm-no">No</button>
        </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
        window.location.href = '{{ path('app_logout') }}';
    });
    
    // Handle No button - remove modal
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
    });
  });
  
  // Delete confirmation handler
  $('.delete-btn').on('click', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'car' ? 'car' : 'user';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });
  
  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'car' ? 'car' : 'user';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
  });
  }
});
</script>
{% endblock %}
