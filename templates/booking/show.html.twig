{% extends 'booking/_admin_layout.html.twig' %}

{% block title %}Booking #{{ booking.id }}{% endblock %}

{% block booking_inner %}
  <h1 class="page-title">Booking Details</h1>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <div class="table-container">
    <table class="table">
      <tbody>
        <tr>
          <th style="width: 200px;">ID</th>
          <td>{{ booking.id }}</td>
        </tr>
        <tr>
          <th>Name</th>
          <td>{{ booking.name }}</td>
        </tr>
        <tr>
          <th>Phone</th>
          <td>{{ booking.phone|default('—') }}</td>
        </tr>
        <tr>
          <th>Status</th>
          <td>
            <div class="booking-detail-status">
              <span class="booking-status-label">{{ booking.status }}</span>
              {% include 'booking/_status_actions.html.twig' %}
            </div>
          </td>
        </tr>
        <tr>
          <th>Car</th>
          <td>
            {% if booking.car %}
              {{ booking.car.Brand }} {{ booking.car.Model }} (ID: {{ booking.car.id }})
            {% else %}
              <span class="text-muted">Not assigned</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Pickup Location</th>
          <td>{{ booking.pickupLocation }}</td>
        </tr>
        <tr>
          <th>Drop-off Location</th>
          <td>{{ booking.dropoffLocation }}</td>
        </tr>
        <tr>
          <th>Pickup Date &amp; Time</th>
          <td>
            {% if booking.pickupDate %}
              {{ booking.pickupDate|date('Y-m-d') }}
              {% if booking.pickupTime %}
                at {{ booking.pickupTime|date('g:i A') }}
              {% endif %}
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Return Date &amp; Time</th>
          <td>
            {% if booking.returnDate %}
              {{ booking.returnDate|date('Y-m-d') }}
              {% if booking.returnTime %}
                at {{ booking.returnTime|date('g:i A') }}
              {% endif %}
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
      </tbody>
    </table>

    {% set canEdit = false %}
    {% if is_granted('ROLE_ADMIN') %}
      {% set canEdit = true %}
    {% elseif booking.createdBy and app.user %}
      {% if booking.createdBy.id == app.user.id %}
        {% set canEdit = true %}
      {% endif %}
    {% endif %}

    <div class="d-flex flex-wrap gap-2 mt-4 align-items-center">
      <a href="{{ path('app_booking_index') }}" class="btn btn-outline-secondary">← Back to List</a>
      {% if canEdit %}
        <a href="{{ path('app_booking_edit', {'id': booking.id}) }}" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
        {{ include('booking/_delete_form.html.twig') }}
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block booking_scripts %}
<script>
$(function() {
  $(document).on('click', '.delete-btn', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    const modal = $('<div>').addClass('warning-modal');
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this booking? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button type="button" id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button type="button" id="confirm-no">Cancel</button>
      </div>`);
    overlay.append(modal);
    $('body').append(overlay);
    overlay.find('#confirm-yes').on('click', function() {
      overlay.remove();
      form.off('submit').submit();
    });
    overlay.find('#confirm-no').on('click', function() { overlay.remove(); });
    overlay.on('click', function(ev) { if (ev.target === overlay[0]) overlay.find('#confirm-no').click(); });
  });
});
</script>
{% endblock %}
