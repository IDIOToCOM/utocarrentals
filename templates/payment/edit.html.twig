{% extends 'payment/_admin_layout.html.twig' %}

{% block title %}Edit Payment{% endblock %}

{% block payment_inner %}
  <h1 class="page-title">Edit Payment</h1>

  {% if form is defined %}
    {{ form_errors(form) }}
  {% endif %}

  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <div class="table-container">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
      {% for field in form %}
        {% if field.vars.name != '_token' %}
          <div class="form-group mb-3">
            {{ form_label(field) }}
            {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(field) }}
          </div>
        {% endif %}
      {% endfor %}

      <div class="d-flex justify-content-between mt-4 flex-wrap gap-2">
        <a href="{{ path('app_payment_index') }}" class="btn btn-outline-secondary">← Back to List</a>
        <button type="submit" class="btn btn-success">✔ Update</button>
      </div>
    {{ form_end(form) }}

    {% set isOwner = false %}
    {% if payment.createdBy is not null and app.user is not null %}
      {% if payment.createdBy.id == app.user.id %}
        {% set isOwner = true %}
      {% endif %}
    {% endif %}
    {% if is_granted('ROLE_ADMIN') or isOwner %}
      <div class="mt-3 pt-3 border-top text-end">
        {{ include('payment/_delete_form.html.twig') }}
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block payment_scripts %}
<script>
$(function() {
  $(document).on('click', '.delete-btn', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    const modal = $('<div>').addClass('warning-modal');
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this payment? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button type="button" id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button type="button" id="confirm-no">Cancel</button>
      </div>`);
    overlay.append(modal);
    $('body').append(overlay);
    overlay.find('#confirm-yes').on('click', function() {
      overlay.remove();
      form.off('submit').submit();
    });
    overlay.find('#confirm-no').on('click', function() { overlay.remove(); });
    overlay.on('click', function(ev) { if (ev.target === overlay[0]) overlay.find('#confirm-no').click(); });
  });
});
</script>
{% endblock %}
