{% for payment in payments %}
  <tr>
    <td>{{ payment.id }}</td>
    <td>
      {% if payment.booking %}
        <a href="{{ path('app_booking_show', { id: payment.booking.id }) }}">#{{ payment.booking.id }}</a>
      {% else %}
        <span class="text-muted">—</span>
      {% endif %}
    </td>
    <td>{{ payment.name }}</td>
    <td>
      {% if payment.car is not null %}
        {{ payment.car.Brand }} {{ payment.car.Model }}
      {% else %}
        <span class="text-muted">Car Deleted</span>
      {% endif %}
    </td>
    <td>₱{{ payment.amountDue|number_format(0, '.', ',') }}</td>
    <td>
      {% if payment.amountPaid %}
        ₱{{ payment.amountPaid|number_format(0, '.', ',') }}
      {% else %}
        <span class="text-muted">—</span>
      {% endif %}
    </td>
    <td>
      <span class="badge bg-{% if payment.status == 'Completed' %}success{% elseif payment.status == 'Pending' %}warning{% elseif payment.status == 'Failed' %}danger{% else %}secondary{% endif %}">
        {{ payment.status == 'Completed' ? 'Paid' : payment.status }}
      </span>
    </td>
    <td>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <a href="{{ path('app_payment_show', {'id': payment.id}) }}" class="btn btn-show"><i class="fas fa-eye"></i> Show</a>
        <a href="{{ path('app_payment_edit', {'id': payment.id}) }}" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
        {% set isOwner = false %}
        {% if payment.createdBy is not null and app.user is not null %}
          {% set createdById = payment.createdBy.id %}
          {% set currentUserId = app.user.id %}
          {% if createdById == currentUserId %}
            {% set isOwner = true %}
          {% endif %}
        {% endif %}
        {% if is_granted('ROLE_ADMIN') or isOwner %}
          <form method="post" action="{{ path('app_payment_delete', {'id': payment.id}) }}" class="delete-form" data-entity-name="payment" style="display: inline-block;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment.id) }}">
            <button type="button" class="btn btn-danger delete-btn"><i class="fas fa-trash"></i> Delete</button>
          </form>
        {% endif %}
      </div>
    </td>
  </tr>
{% else %}
  <tr>
    <td colspan="8" style="text-align:center; padding:2rem;">No payments found</td>
  </tr>
{% endfor %}
