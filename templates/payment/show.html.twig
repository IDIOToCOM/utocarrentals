{% extends 'payment/_admin_layout.html.twig' %}

{% block title %}Payment #{{ payment.id }}{% endblock %}

{% block payment_inner %}
  <h1 class="page-title">Payment Details</h1>

  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <div class="table-container">
    <table class="table">
      <tbody>
        <tr>
          <th style="width: 200px;">ID</th>
          <td>{{ payment.id }}</td>
        </tr>
        <tr>
          <th>Booking</th>
          <td>
            {% if payment.booking %}
              <a href="{{ path('app_booking_show', { id: payment.booking.id }) }}">#{{ payment.booking.id }}</a>
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Name</th>
          <td>{{ payment.name }}</td>
        </tr>
        <tr>
          <th>Amount due</th>
          <td>₱{{ payment.amountDue|number_format(0, '.', ',') }}</td>
        </tr>
        <tr>
          <th>Amount paid</th>
          <td>
            {% if payment.amountPaid %}
              ₱{{ payment.amountPaid|number_format(0, '.', ',') }}
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
        </tr>
        {% if payment.paidAt %}
        <tr>
          <th>Paid at</th>
          <td>{{ payment.paidAt|date('M j, Y g:i A') }}</td>
        </tr>
        {% endif %}
        <tr>
          <th>Car</th>
          <td>
            {% if payment.car %}
              {{ payment.car.Brand }} {{ payment.car.Model }} (ID: {{ payment.car.id }})
            {% else %}
              <span class="text-muted">Car deleted or unassigned</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Status</th>
          <td>
            <span class="badge bg-{% if payment.status == 'Completed' %}success{% elseif payment.status == 'Pending' %}warning{% elseif payment.status == 'Failed' %}danger{% else %}secondary{% endif %}">
              {{ payment.status == 'Completed' ? 'Paid' : payment.status }}
            </span>
          </td>
        </tr>
      </tbody>
    </table>

    {% set isOwner = false %}
    {% if payment.createdBy is not null and app.user is not null %}
      {% if payment.createdBy.id == app.user.id %}
        {% set isOwner = true %}
      {% endif %}
    {% endif %}

    <div class="d-flex flex-wrap gap-2 mt-4 align-items-center">
      <a href="{{ path('app_payment_index') }}" class="btn btn-outline-secondary">← Back to List</a>
      <a href="{{ path('app_payment_edit', { id: payment.id }) }}" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
      {% if is_granted('ROLE_ADMIN') or isOwner %}
        {{ include('payment/_delete_form.html.twig') }}
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block payment_scripts %}
<script>
$(function() {
  $(document).on('click', '.delete-btn', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    const modal = $('<div>').addClass('warning-modal');
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this payment? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button type="button" id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button type="button" id="confirm-no">Cancel</button>
      </div>`);
    overlay.append(modal);
    $('body').append(overlay);
    overlay.find('#confirm-yes').on('click', function() {
      overlay.remove();
      form.off('submit').submit();
    });
    overlay.find('#confirm-no').on('click', function() { overlay.remove(); });
    overlay.on('click', function(ev) { if (ev.target === overlay[0]) overlay.find('#confirm-no').click(); });
  });
});
</script>
{% endblock %}
