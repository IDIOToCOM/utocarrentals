{% extends 'base.html.twig' %}

{% block title %}Payment Index{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/user.css') }}?v=3.2">
  <link rel="stylesheet" href="{{ asset('styles/admin_sidebar.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.0">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block body %}
<div class="admin-layout">
  
  {% include 'payment/_sidebar.html.twig' %}

  <!-- ✅ Main Content -->
  <main class="admin-content">
    {% include 'admin/_topbar.html.twig' %}

    <div class="container">
      <h1 class="page-title">Payment Index</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="table-container">
        <table class="table" id="paymentsTable" data-poll-url="{{ path('app_payment_poll') }}">
          <thead>
            <tr>
              <th>ID</th>
              <th>Booking</th>
              <th>Name</th>
              <th>Car</th>
              <th>Due</th>
              <th>Paid</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="paymentsTableBody">{% include 'payment/_rows.html.twig' with { payments: payments } %}</tbody>
        </table>
      </div>


    </div>
  </main>
</div>

<!-- ✅ Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
$(document).ready(function() {
  // Sidebar toggle
  $('#sidebarToggle').on('click', function() {
    $('.admin-sidebar').toggleClass('collapsed');
    $('.admin-content').toggleClass('expanded');
  });

  // DataTables init
  const tableElement = $('#paymentsTable');
  let table = tableElement.DataTable({
    ordering: false,
    paging: true,
    searching: true,
    pageLength: 10,
    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]]
  });

  let lastRowsHtml = $('#paymentsTableBody').html();
  let pollInFlight = false;

  function refreshPaymentsTableRows(rowsHtml) {
    const currentPage = table.page();
    const currentSearch = table.search();
    table.destroy();
    $('#paymentsTableBody').html(rowsHtml);
    table = tableElement.DataTable({
      ordering: false,
      paging: true,
      searching: true,
      pageLength: 10,
      lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]]
    });
    table.search(currentSearch).draw(false);
    table.page(currentPage).draw(false);
  }

  function pollPayments() {
    if (pollInFlight || document.hidden) {
      return;
    }
    const pollUrl = tableElement.data('poll-url');
    if (!pollUrl) {
      return;
    }
    pollInFlight = true;
    fetch(pollUrl, {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      credentials: 'same-origin',
      cache: 'no-store'
    })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('Failed to poll payments');
        }
        return response.json();
      })
      .then(function(payload) {
        if (!payload || typeof payload.rowsHtml !== 'string') {
          return;
        }
        if (payload.rowsHtml !== lastRowsHtml) {
          refreshPaymentsTableRows(payload.rowsHtml);
          lastRowsHtml = payload.rowsHtml;
        }
      })
      .catch(function() {
        // Ignore transient errors, next poll will retry.
      })
      .finally(function() {
        pollInFlight = false;
      });
  }

  setInterval(pollPayments, 10000);
  
  // Delete confirmation handler
  $(document).on('click', '.delete-btn', function(e) {
    e.preventDefault();
    e.stopPropagation();
    const form = $(this).closest('.delete-form');
    if (form.length === 0) {
      console.error('Delete form not found');
      return;
    }
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'payment' ? 'payment' : 'item';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });
  
  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'payment' ? 'payment' : 'item';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
      }
    });
  }
});

// Logout confirmation dialog
document.getElementById('logout-btn').addEventListener('click', function(e) {
    e.preventDefault();
    
    // Create modal overlay
    const overlay = document.createElement('div');
    overlay.className = 'logout-overlay';
    
    // Create modal dialog
    const modal = document.createElement('div');
    modal.className = 'logout-modal';
    
    modal.innerHTML = `
        <h3>Logout Confirmation</h3>
        <p>Are you sure you want to logout?</p>
        <div class="logout-buttons">
            <button id="confirm-yes">Yes</button>
            <button id="confirm-no">No</button>
        </div>
    `;
    
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    
    // Handle Yes button
    document.getElementById('confirm-yes').addEventListener('click', function() {
        window.location.href = '{{ path('app_logout') }}';
    });
    
    // Handle No button - remove modal
    document.getElementById('confirm-no').addEventListener('click', function() {
        overlay.classList.add('fade-out');
        modal.classList.add('slide-down');
        setTimeout(() => {
            document.body.removeChild(overlay);
        }, 200);
    });
    
    // Close on overlay click
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
            document.getElementById('confirm-no').click();
        }
    });
});
</script>
{% endblock %}
