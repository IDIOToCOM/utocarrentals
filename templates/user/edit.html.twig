{% extends 'base.html.twig' %}

{% block title %}Edit User - {{ login.username }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/adminbooking.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/admin_sidebar.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.1">
{% endblock %}

{% block body %}
<div class="admin-layout">
  
  {% include 'admin/_sidebar.html.twig' %}

  <!-- ✅ Main Content -->
  <main class="admin-content">
    {% include 'admin/_topbar.html.twig' %}

    <div class="container">
      <h1 class="page-title">Edit User</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="table-container">
        <div class="card">
          <div class="card-body">
            {{ form_start(form, {'attr': {'id': 'user-edit-form'}}) }}
              <div class="mb-3">
                {{ form_label(form.username, 'Username', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.username) }}
              </div>
              <div class="mb-3">
                {{ form_label(form.roles, 'Roles', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.roles) }}
                {{ form_errors(form.roles) }}
              </div>
              <div class="mb-3">
                <div class="form-check">
                  {{ form_widget(form.isEnabled, {'attr': {'class': 'form-check-input'}}) }}
                  {{ form_label(form.isEnabled, 'Account Enabled', {'label_attr': {'class': 'form-check-label'}}) }}
                  {{ form_errors(form.isEnabled) }}
                </div>
                <small class="form-text text-muted">Uncheck to disable this user account. Disabled users cannot log in.</small>
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Cancel</a>
              </div>
            {{ form_end(form) }}

            <div class="mt-3">
              {{ include('user/_delete_form.html.twig', {'login': login}) }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ✅ Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
$(document).ready(function() {
  $('#sidebarToggle').on('click', function() {
    $('.admin-sidebar').toggleClass('collapsed');
    $('.admin-content').toggleClass('expanded');
  });
  
  // Form validation
  const form = $('#user-edit-form');
  if (form.length > 0) {
    form.on('submit', function(e) {
      e.preventDefault();
      
      // Validate all required fields
      const usernameInput = $('[name*="[username]"]');
      
      const missingFields = [];
      
      if (!usernameInput.val() || usernameInput.val().trim() === '') {
        missingFields.push('Username');
      }
      
      if (missingFields.length > 0) {
        const fieldList = missingFields.join(', ');
        showWarningModal('Please fill in all required fields: ' + fieldList);
        return false;
      }
      
      // If all fields are filled, submit the form
      form.off('submit');
      this.submit();
    });
  }
  
  function showWarningModal(message) {
    // Remove any existing modals first
    $('.warning-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    modal.html(`
      <h3>⚠️ Validation Warning</h3>
      <p>${message}</p>
      <div class="warning-buttons">
        <button id="warning-ok">OK</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle OK button
    $('#warning-ok').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        location.reload();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        $('#warning-ok').click();
      }
    });
  }
  
  // Delete confirmation handler
  $('.delete-btn').on('click', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'car' ? 'car' : 'user';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });
  
  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'car' ? 'car' : 'user';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
      }
    });
  }
});
</script>
{% endblock %}
