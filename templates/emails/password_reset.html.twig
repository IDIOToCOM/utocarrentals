<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Reset your password</title>
</head>
<body>
  <h1>Password reset</h1>
  <p>Hi{% if user.displayName %} {{ user.displayName }}{% else %} {{ user.username }}{% endif %},</p>
  <p>We received a request to reset your Uto account password. Click the button below to choose a new password. This link expires in {{ expiresHours }} hour(s).</p>
  <p>
    <a href="{{ resetUrl }}" style="display: inline-block; padding: 10px 20px; background-color: #0a0a0a; color: white; text-decoration: none; border-radius: 5px;">
      Reset password
    </a>
  </p>
  <p>Or copy and paste this link into your browser:</p>
  <p>{{ resetUrl }}</p>
  <p>If you did not request a reset, you can ignore this email.</p>
  <p>Thanks,<br>Uto Car Rentals</p>
</body>
</html>
