{% extends 'base.html.twig' %}

{% block title %}Car Inventory{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/car_inventory.css') }}?v=3.1">
  <link rel="stylesheet" href="{{ asset('styles/admin_sidebar.css') }}?v=2.0">
  <link rel="stylesheet" href="{{ asset('styles/logout.css') }}?v=2.3">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block body %}
<div class="admin-layout">
  
  {% include 'car_inventory/_sidebar.html.twig' %}

  <!-- ✅ Main Content -->
  <main class="admin-content">
    {% include 'admin/_topbar.html.twig' %}

    <div class="container">
      <h1 class="page-title">Car Inventory</h1>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Brand</th>
              <th>Model</th>
              <th>Type</th>
              <th>Price / Day</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for car_inventory in car_inventories %}
            <tr>
              <td data-label="ID">{{ car_inventory.id }}</td>
              <td data-label="Brand">{{ car_inventory.Brand }}</td>
              <td data-label="Model">{{ car_inventory.Model }}</td>
              <td data-label="Type">{{ car_inventory.Type }}</td>
              <td data-label="Price / Day">₱{{ car_inventory.PricePerDay }}</td>
              <td data-label="Status">
                <span class="status {% if car_inventory.Status == 'Available' %}available{% elseif car_inventory.Status == 'Out of service' %}out-of-service{% else %}unavailable{% endif %}">
                  {{ car_inventory.Status }}
                </span>
              </td>
              <td data-label="Actions">
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="{{ path('app_car_inventory_photo', {'id': car_inventory.id}) }}" class="btn btn-photo" title="View vehicle photo"><i class="fas fa-image"></i> Photo</a>
                <a href="{{ path('app_car_inventory_show', {'id': car_inventory.id}) }}" class="btn btn-show"><i class="fas fa-eye"></i> Show</a>
                {# Edit button: Staff can edit any record, admin can edit all #}
                <a href="{{ path('app_car_inventory_edit', {'id': car_inventory.id}) }}" class="btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
                {# Delete button: Only show if admin OR if staff owns the record #}
                {% set isOwner = false %}
                {% if car_inventory.createdBy is not null and app.user is not null %}
                  {% set createdById = car_inventory.createdBy.id %}
                  {% set currentUserId = app.user.id %}
                  {% if createdById == currentUserId %}
                    {% set isOwner = true %}
                  {% endif %}
                {% endif %}
                {% if is_granted('ROLE_ADMIN') or isOwner %}
                  {% set booking_n = booking_counts[car_inventory.id] ?? 0 %}
                  <form method="post" action="{{ path('app_car_inventory_delete', {'id': car_inventory.id}) }}" class="delete-form" data-entity-name="car" data-has-bookings="{{ booking_n > 0 ? '1' : '0' }}" style="display: inline-block; margin: 0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ car_inventory.id) }}">
                    <button type="button" class="btn btn-danger delete-btn"><i class="fas fa-trash"></i> Delete</button>
                  </form>
                {% endif %}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" style="text-align:center; padding:2rem;">No records found</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="text-center mt-3">
        <a href="{{ path('app_car_inventory_new') }}" class="btn btn-create"><i class="fas fa-plus"></i> Create New Car</a>
  </main>
</div>

<!-- ✅ Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
{% include 'car_inventory/_delete_blocked_modal_template.html.twig' %}

<script>
$(document).ready(function() {
  // Sidebar toggle for mobile
  $('#sidebarToggle').on('click', function() {
    $('.admin-sidebar').toggleClass('collapsed');
    $('.admin-content').toggleClass('expanded');
  });

  // DataTable custom filtering
  $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
    const status = data[5].trim().toLowerCase();
    const search = $('.dataTables_filter input').val().trim().toLowerCase();
    if (!search) return true;
    if (search === 'available') return status === 'available';
    if (search === 'unavailable') return status === 'unavailable';
    return data.join(' ').toLowerCase().includes(search);
  });

  const table = $('.table').DataTable({
    ordering: false,
    paging: true,
    searching: true
  });

  $('.dataTables_filter input').on('keyup', function() {
    table.draw();
});

// Logout confirmation dialog
  $('#logout-btn').on('click', function(e) {
    e.preventDefault();
    
    // Remove any existing modals first
    $('.logout-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('logout-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('logout-modal').html(`
      <h3>Logout Confirmation</h3>
      <p>Are you sure you want to logout?</p>
      <div class="logout-buttons">
        <button id="confirm-yes">Yes</button>
        <button id="confirm-no">No</button>
        </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
        window.location.href = '{{ path('app_logout') }}';
    });
    
    // Handle No button - remove modal
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
    });
  });
  
  // Delete confirmation handler
  $('.delete-btn').on('click', function(e) {
    e.preventDefault();
    const form = $(this).closest('.delete-form');
    if (form.attr('data-has-bookings') === '1') {
      if (typeof window.utoShowCarDeleteBlockedModal === 'function') {
        window.utoShowCarDeleteBlockedModal();
      }
      return;
    }
    const entityName = form.data('entity-name') || 'item';
    const entityType = entityName === 'booking' ? 'booking' : entityName === 'car' ? 'car' : 'user';
    
    showDeleteConfirmation(entityType, function() {
      form.off('submit');
      form.submit();
    });
  });

  function showDeleteConfirmation(entityType, onConfirm) {
    // Remove any existing modals first
    $('.delete-confirm-overlay').remove();
    
    // Create modal overlay
    const overlay = $('<div>').addClass('delete-confirm-overlay warning-overlay');
    
    // Create modal dialog
    const modal = $('<div>').addClass('warning-modal');
    
    const entityLabel = entityType === 'booking' ? 'booking' : entityType === 'car' ? 'car' : 'user';
    
    modal.html(`
      <h3>⚠️ Confirm Deletion</h3>
      <p>Are you sure you want to delete this ${entityLabel}? This action cannot be undone.</p>
      <div class="warning-buttons">
        <button id="confirm-yes" class="btn-danger">Yes, Delete</button>
        <button id="confirm-no">Cancel</button>
      </div>
    `);
    
    overlay.append(modal);
    $('body').append(overlay);
    
    // Handle Yes button
    overlay.find('#confirm-yes').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
        if (onConfirm) onConfirm();
      }, 200);
    });
    
    // Handle No button
    overlay.find('#confirm-no').on('click', function() {
      overlay.addClass('fade-out');
      modal.addClass('slide-down');
      setTimeout(function() {
        overlay.remove();
      }, 200);
    });
    
    // Close on overlay click
    overlay.on('click', function(e) {
      if (e.target === overlay[0]) {
        overlay.find('#confirm-no').click();
        }
  });
  }
});
</script>
{% endblock %}
