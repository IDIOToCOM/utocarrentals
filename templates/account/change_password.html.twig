{% extends 'landing/base.html.twig' %}
{% import 'customer/_uto_form_field.html.twig' as uto %}

{% block title %}Change password — Uto{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/pages-public.css') }}?v=2.4">
  <link rel="stylesheet" href="{{ asset('styles/customer-booking.css') }}?v=1.7">
  <link rel="stylesheet" href="{{ asset('styles/uto-form-fields.css') }}?v=1.0">
  <link rel="stylesheet" href="{{ asset('styles/customer-account.css') }}?v=1.1">
{% endblock %}

{% block body %}
{% include 'landing/_header_customer.html.twig' %}

<main class="lp-page-main lp-account-main" id="main-content">
  <section class="lp-page-hero">
    <div class="lp-container">
      <p class="lp-kicker">Account</p>
      <h1 class="lp-page-title">Change password</h1>
      <p class="lp-page-lead">Enter a new password below. Use at least 6 characters.</p>
      <p class="mt-2 mb-0"><a href="{{ path('app_customer_account') }}" class="lp-btn lp-btn-ghost lp-btn-sm"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to account</a></p>
    </div>
  </section>

  <section class="lp-section lp-page-section">
    <div class="lp-container">
      {% for message in app.flashes('success') %}
        <div class="lp-booking-alert lp-booking-alert--success" role="status">{{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('info') %}
        <div class="lp-booking-alert lp-booking-alert--success" role="status">{{ message }}</div>
      {% endfor %}
      <div class="lp-account-card lp-account-card--narrow">
        {{ form_start(passwordForm, { attr: { class: 'lp-account-form', novalidate: 'novalidate' } }) }}
          {{ uto.render_password_pair(passwordForm.plainPassword, {
            first_placeholder: 'New password',
            second_placeholder: 'Confirm new password'
          }) }}
          <div class="lp-account-form__actions">
            <button type="submit" class="lp-btn lp-btn-primary">Update password</button>
            <a href="{{ path('app_customer_account') }}" class="lp-btn lp-btn-ghost">Cancel</a>
          </div>
        {{ form_end(passwordForm) }}
      </div>
    </div>
  </section>
</main>

{% include 'landing/_footer_customer.html.twig' %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% include 'landing/_scripts_public.html.twig' %}
{% endblock %}
