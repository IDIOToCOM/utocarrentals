# Copy to .env.local on your machine, or set these in Laravel Forge → Site → Environment.
# Do not commit real secrets to git.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_this_to_a_random_string
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://your-domain.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local dev:
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/uto_db?serverVersion=8.0.32&charset=utf8mb4"
#
# Laravel Forge (set in Site → Environment, NOT in git):
#   DATABASE_URL="mysql://forge:PASSWORD@127.0.0.1:3306/uto_carrentals?serverVersion=8.0&charset=utf8mb4"
# Or after Site → Database → Install Database, leave DATABASE_URL unset and deploy runs
# scripts/forge-database.sh (builds URL from DB_HOST, DB_USERNAME, DB_PASSWORD, DB_DATABASE).
# See docs/FORGE_DEPLOY.md
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_DEFAULT_FROM_EMAIL=noreply@example.com
MAILER_DEFAULT_FROM_NAME="UTO Mobility"
###< symfony/mailer ###

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CONTACT_FORM_EMBED_URL=

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|your-domain\.com)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_jwt_passphrase
###< lexik/jwt-authentication-bundle ###
